{
  "name": "@kobokit/statement-math",
  "version": "0.0.0",
  "description": "Exact arithmetic for bank statements (placeholder).",
  "license": "MIT",
  "author": "Ugochukwu Okoli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Okoli-Ryan/kobokit.git",
    "directory": "packages/statement-math"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-package": "publint && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@kobokit/eslint-config": "workspace:*",
    "@kobokit/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "publint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
