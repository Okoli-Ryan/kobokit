{
  "name": "@kobokit/pdf-source-viewer",
  "version": "0.0.0",
  "description": "React viewer that highlights the PDF source behind a parsed statement value (placeholder).",
  "license": "MIT",
  "author": "Ugochukwu Okoli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Okoli-Ryan/kobokit.git",
    "directory": "packages/pdf-source-viewer"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check-package": "publint && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@jest/globals": "catalog:",
    "@kobokit/eslint-config": "workspace:*",
    "@kobokit/tsconfig": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "publint": "catalog:",
    "react": "^19.3.1",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
