{
  "name": "@kobokit/statement-generator",
  "version": "0.0.0",
  "description": "Synthetic Nigerian-style bank statements (PDF and JSON, with the answer attached) for testing statement parsers, fraud detectors and AI pipelines.",
  "license": "MIT",
  "author": "Ugochukwu Okoli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Okoli-Ryan/kobokit.git",
    "directory": "packages/statement-generator"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "kobokit-statements": "./dist/cli.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-package": "publint && attw --pack .",
    "samples": "node scripts/make-samples.mjs",
    "preview-page": "node scripts/pdf-to-png.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@kobokit/eslint-config": "workspace:*",
    "@kobokit/tsconfig": "workspace:*",
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "fast-check": "^4.10.2",
    "pdfjs-dist": "^6.5.438",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "keywords": [
    "bank-statement",
    "synthetic-data",
    "test-data",
    "fintech",
    "nigeria",
    "fixtures"
  ]
}
