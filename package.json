{
  "name": "kobokit",
  "private": true,
  "description": "Open tools for analysing African bank statements.",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check-package": "turbo run check-package",
    "check:release": "node tools/check-release.mjs",
    "test:tools": "node --test \"tools/*.test.mjs\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "verify": "pnpm format:check && pnpm test:tools && pnpm check:release && turbo run lint typecheck test build check-package",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
